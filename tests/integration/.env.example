# Required non-secret setting. The repository must be PRIVATE, disposable,
# wiki-enabled, writable by the test token, and contain the current workflows.
WIKIKB_TEST_REPO=githubnext/wikikb-test

TEST_KB_NAME=wikikb-test
TEST_ISSUES_REPO=cli/cli
WIKIKB_AI_MODEL=claude-sonnet-4.6

# Optional controlled LexCAT runtime override. Leave unset to exercise the
# vendored executable for the current platform.
# WIKIKB_LEXCAT_BIN=/absolute/path/to/lexcat

# Local runs use the active `gh auth token` when these overrides are unset.
# Keep this ignored file private if you choose to set either value here.
# WIKIKB_INTEGRATION_TOKEN=
# WIKIKB_COPILOT_TOKEN=
